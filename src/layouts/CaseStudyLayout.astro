---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import PageLayout from './PageLayout.astro';
import Container from '../components/ui/Container.astro';
import Tag from '../components/ui/Tag.astro';
import ProjectMeta from '../components/project/ProjectMeta.astro';
import ProjectNav from '../components/project/ProjectNav.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
}

const { project, prev, next } = Astro.props;
const { title, summary, cover, coverAlt, tags, company, confidential } = project.data;
const eyebrow = company ?? tags[0] ?? 'Case study';
---

<PageLayout title={title} description={summary} image={cover.src}>
  <article>
    <Container class="pt-12 sm:pt-16">
      <div class="max-w-[var(--prose-width)]" data-reveal>
        <p class="text-xs font-medium tracking-wide text-accent uppercase">{eyebrow}</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tightest text-ink sm:text-6xl">{title}</h1>
        <p class="mt-5 text-lg text-ink-muted">{summary}</p>
        {
          tags.length > 0 && (
            <div class="mt-5 flex flex-wrap gap-2">
              {tags.map((tag) => <Tag>{tag}</Tag>)}
            </div>
          )
        }
        {
          confidential && (
            <p class="mt-4 text-sm text-ink-muted">
              Algunos detalles de este proyecto se mantienen confidenciales por acuerdo con el cliente/empresa.
            </p>
          )
        }
      </div>

      <div class="mt-10" data-reveal>
        <ProjectMeta project={project} />
      </div>
    </Container>

    <Container class="mt-12" data-reveal>
      <Image src={cover} alt={coverAlt} width={1600} class="w-full rounded-2xl" priority />
    </Container>

    <Container class="prose prose-neutral mt-16 max-w-[var(--prose-width)] dark:prose-invert prose-headings:font-display prose-headings:tracking-tightest">
      <slot />
    </Container>

    <Container class="mt-16 mb-24">
      <ProjectNav prev={prev} next={next} />
    </Container>
  </article>
</PageLayout>
