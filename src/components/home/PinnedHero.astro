---
import Container from '../ui/Container.astro';
import { site as siteEs } from '../../content-data/site';
import { site as siteEn } from '../../content-data/site.en';
import type { Locale } from '../../i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const site = locale === 'en' ? siteEn : siteEs;
---

<section
  data-hero-grid-section
  class="relative flex min-h-[480px] flex-col justify-center overflow-hidden bg-paper py-12 text-ink sm:min-h-[540px] sm:py-16 lg:min-h-[560px]"
>
  {
    /*
      Grilla de puntos reactiva al cursor (src/lib/motion/hero-grid.ts):
      referencia visual a "los sistemas que sostienen un producto", en línea
      con "entiendo el producto más allá del píxel". Solo se monta con mouse
      fino y sin prefers-reduced-motion; si no, el canvas queda vacío y el
      hero se ve limpio, sin hueco.
    */
  }
  <canvas data-hero-grid class="pointer-events-none absolute inset-0 z-0" aria-hidden="true"></canvas>

  <Container class="relative z-[1]">
    <h1
      class="mt-4 max-w-4xl font-display text-4xl font-bold tracking-tightest text-ink sm:text-6xl lg:text-7xl"
      data-reveal
    >
      {site.tagline}
    </h1>
    <p class="mt-6 max-w-2xl text-lg text-ink-muted sm:text-xl" data-reveal>
      {site.subheading}
    </p>
  </Container>
</section>
