---
import Container from '../ui/Container.astro';
import { site as siteEs } from '../../content-data/site';
import { site as siteEn } from '../../content-data/site.en';
import type { Locale } from '../../i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
const site = locale === 'en' ? siteEn : siteEs;
---

<section
  data-hero-grid-section
  class="relative flex min-h-[400px] flex-col justify-center overflow-hidden bg-ink py-10 text-paper sm:min-h-[440px] sm:py-12 lg:min-h-[480px]"
>
  {/* Fondo ASCII animado; el texto del canvas es decorativo y el mensaje principal sigue siendo HTML. */}
  <canvas data-hero-grid class="pointer-events-none absolute inset-0 z-0" aria-hidden="true"></canvas>

  <Container class="relative z-[1]">
    <h1
      class="max-w-4xl font-display text-4xl font-bold tracking-tightest text-paper sm:text-5xl lg:text-6xl"
      data-reveal
    >
      {site.tagline}
    </h1>
    <p class="mt-5 max-w-2xl text-base leading-relaxed text-paper/70 sm:text-lg" data-reveal>
      {site.subheading}
    </p>
  </Container>
</section>
