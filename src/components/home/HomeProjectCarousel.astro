---
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import type { ProjectEntry } from '../../lib/content-types';
import { t, type Locale } from '../../i18n/ui';
import { projectHref } from '../../i18n/paths';

interface Props {
  projects: ProjectEntry[];
  label: string;
}

const { projects, label } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<div
  data-project-scroller
  role="region"
  aria-label={`${t(locale, 'experience.projectsIn')} ${label}`}
  class="relative left-1/2 mt-10 flex w-screen -translate-x-1/2 cursor-grab gap-8 overflow-x-auto px-[max(1.5rem,calc((100vw-var(--content-width))/2+1.5rem))] [scrollbar-width:none] active:cursor-grabbing sm:mt-12 sm:gap-10 sm:px-[max(2rem,calc((100vw-var(--content-width))/2+2rem))] [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
>
  {projects.map((project) => (
    <a
      href={project.data.externalUrl ?? projectHref(locale, project.id)}
      target={project.data.externalUrl ? '_blank' : undefined}
      rel={project.data.externalUrl ? 'noopener noreferrer' : undefined}
      aria-labelledby={`home-project-${project.id}`}
      class="group block w-[340px] shrink-0 [perspective:800px] sm:w-[480px] lg:w-[540px]"
      data-tilt
      data-project-id={project.id}
    >
      <div class="project-card-media" data-tilt-target>
        <Image
          src={project.data.thumbnail ?? project.data.cover}
          alt={project.data.thumbnailAlt ?? project.data.coverAlt}
          width={1200}
          height={1200}
          class="project-card-image"
        />
        <span class="visited-badge absolute right-3 top-3 h-7 w-7 items-center justify-center rounded-full bg-accent-blue text-paper" aria-hidden="true">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
          </svg>
        </span>
      </div>
      <h3 id={`home-project-${project.id}`} class="mt-5 font-display text-lg font-semibold text-ink sm:mt-6 sm:text-xl">
        {project.data.title}
      </h3>
      {project.data.tags.length > 0 && (
        <div class="mt-3 flex flex-wrap gap-2">
          {project.data.tags.map((tag) => <Tag>{tag}</Tag>)}
        </div>
      )}
    </a>
  ))}
</div>
