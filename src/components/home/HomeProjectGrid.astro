---
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import type { ProjectEntry } from '../../lib/content-types';
import type { Locale } from '../../i18n/ui';
import { projectHref } from '../../i18n/paths';
import { normalizeProjectTag } from '../../lib/project-tags';

interface ProjectItem {
  project: ProjectEntry;
  company: string;
}

interface Props {
  items: ProjectItem[];
  label: string;
}

const { items, label } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<section id="projects" data-home-project-group aria-label={label} class="mx-auto w-full max-w-[var(--content-width)] scroll-mt-28 px-6 pb-24 sm:px-8 sm:pb-28">
  <div class="grid grid-cols-1 gap-x-8 gap-y-16 md:grid-cols-2 md:gap-y-20 lg:grid-cols-3 lg:gap-x-6 lg:gap-y-16">
    {
      items.map(({ project, company }) => {
        const href = project.data.externalUrl ?? projectHref(locale, project.id);
        return (
          <a
            href={href}
            target={project.data.externalUrl ? '_blank' : undefined}
            rel={project.data.externalUrl ? 'noopener noreferrer' : undefined}
            aria-labelledby={`home-project-${project.id}`}
            class="group min-w-0 [perspective:800px]"
            data-reveal
            data-tilt
            data-project-id={project.id}
            data-home-project-card
            data-home-project-tags={JSON.stringify(project.data.tags.map(normalizeProjectTag))}
          >
            <div class="project-card-media" data-tilt-target>
              <Image
                src={project.data.thumbnail ?? project.data.cover}
                alt={project.data.thumbnailAlt ?? project.data.coverAlt}
                width={900}
                height={900}
                class="project-card-image"
              />
              <div class="project-company-overlay" aria-hidden="true">
                <span>{company}</span>
              </div>
              <span class="visited-badge absolute right-3 top-3 z-20 h-7 w-7 items-center justify-center rounded-full bg-accent-blue text-paper" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="h-3.5 w-3.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M20 6 9 17l-5-5" />
                </svg>
              </span>
            </div>

            <div class="mt-5 sm:mt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.12em] text-company-overline">
                {company}
              </p>
              <h2 id={`home-project-${project.id}`} class="mt-3 font-display text-xl font-semibold leading-tight text-ink sm:text-2xl">
                {project.data.title}
                {project.data.externalUrl && <span class="ml-1 text-base text-accent-blue" aria-hidden="true">↗</span>}
              </h2>
              {
                project.data.tags.length > 0 && (
                  <div class="mt-4 flex flex-wrap gap-2">
                    {project.data.tags.map((tag) => <Tag>{tag}</Tag>)}
                  </div>
                )
              }
            </div>
          </a>
        );
      })
    }
  </div>
</section>
