---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import LanguageSwitch from '../ui/LanguageSwitch.astro';
import MenuOverlay from './MenuOverlay.astro';
import { site } from '../../content-data/site';
import { t, type Locale } from '../../i18n/ui';
import { homeHref } from '../../i18n/paths';

const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<header class="fixed inset-x-0 top-0 z-[60] border-b border-border bg-paper py-5 sm:py-6">
  <Container class="flex flex-nowrap items-center justify-between gap-x-2 gap-y-3 sm:gap-x-4">
    <a href={homeHref(locale)} class="flex shrink-0 items-center gap-2 whitespace-nowrap text-ink">
      <Logo class="h-6 w-6" />
      <span class="font-display text-sm font-bold sm:text-lg">{site.name}</span>
    </a>
    <div class="ml-auto flex flex-wrap items-center gap-x-3 gap-y-3 sm:gap-x-6">
      <div class="hidden sm:block">
        <Button href="/cv/Antonio-Martinez-CV.pdf" download variant="secondary" size="sm">
          {t(locale, 'header.downloadCv')}
        </Button>
      </div>
      <LanguageSwitch />
      <MenuOverlay />
    </div>
  </Container>
</header>
