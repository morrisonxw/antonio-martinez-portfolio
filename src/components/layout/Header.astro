---
import Logo from '../ui/Logo.astro';
import LanguageSwitch from '../ui/LanguageSwitch.astro';
import { site } from '../../content-data/site';
import type { Locale } from '../../i18n/ui';
import { homeHref } from '../../i18n/paths';

const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<header class="fixed inset-x-0 top-3 z-[60] px-3 sm:top-4 sm:px-4">
  <div class="mx-auto flex w-full max-w-[var(--content-width)] flex-nowrap items-center justify-between gap-x-2 rounded-full border border-border/70 bg-paper/80 px-3 py-3 shadow-lg shadow-ink/5 backdrop-blur-xl supports-[backdrop-filter]:bg-paper/65 sm:gap-x-4 sm:px-8 sm:py-3.5">
    <a href={homeHref(locale)} class="flex shrink-0 items-center gap-2 whitespace-nowrap text-ink">
      <Logo class="h-6 w-6 text-accent" />
      <span class="font-display text-sm font-bold sm:text-lg">{site.name}</span>
    </a>
    <div class="ml-auto flex min-w-0 shrink-0 items-center gap-x-3 sm:gap-x-6">
      <LanguageSwitch />
    </div>
  </div>
</header>
