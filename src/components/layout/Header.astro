---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import Logo from '../ui/Logo.astro';
import MenuOverlay from './MenuOverlay.astro';
import ThemeToggle from '../islands/ThemeToggle';
import { site } from '../../content-data/site';
---

<header class="fixed inset-x-0 top-0 z-[60] border-b border-border bg-paper py-5 sm:py-6">
  <Container class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <a href="/" class="flex shrink-0 items-center gap-2.5 whitespace-nowrap text-ink">
      <Logo class="h-6 w-6" />
      <span class="font-display text-lg font-bold">{site.name}</span>
    </a>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-3 sm:gap-x-6">
      <div class="hidden sm:block">
        <Button href="/cv/Antonio-Martinez-CV.pdf" download variant="secondary" class="px-5 text-sm">
          Descargar CV
        </Button>
      </div>
      <ThemeToggle client:load />
      <MenuOverlay />
    </div>
  </Container>
</header>
