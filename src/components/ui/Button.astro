---
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  class?: string;
  download?: boolean | string;
  target?: string;
  rel?: string;
}

const { href, variant = 'primary', size = 'md', class: className = '', ...rest } = Astro.props;
const Tag = href ? 'a' : 'button';

const base = 'inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-full font-medium transition-colors';
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  // h-9 (36px) a propósito: es la altura ya establecida en el sitio para
  // controles de header/nav (botón cerrar del menú, flecha de volver en
  // case studies) — este tamaño existe para que el CTA de header quede a
  // la misma altura que esos controles, no para reemplazar el tamaño
  // "md" por defecto de los demás botones (CTAs de página sí quieren ser
  // más altos/prominentes).
  sm: 'h-9 px-4 text-sm',
};
const variants = {
  // relative isolate + before:-z-10: el pseudo-elemento pinta por encima del
  // bg-ink propio pero por debajo del contenido en flujo normal (el slot),
  // sin necesitar envolver el slot en un span con z-index — así el barrido
  // de color queda como una capa entre el fondo base y el texto/ícono.
  // isolate asegura que ese z-index negativo compare solo contra este botón,
  // no contra otros elementos con z-index negativo en la página.
  primary:
    'relative isolate overflow-hidden bg-ink text-paper before:absolute before:inset-0 before:-z-10 before:bg-accent before:-translate-x-full before:transition-transform before:duration-500 before:ease-[cubic-bezier(0.16,1,0.3,1)] hover:before:translate-x-0',
  // Borde en --ink (no --border) a propósito: un botón es un componente
  // interactivo y su límite necesita >=3:1 de contraste (WCAG 1.4.11), algo
  // que un hairline decorativo no garantiza. También es más consistente con
  // el estilo de los botones outline de Monzo.
  secondary: 'border border-ink text-ink hover:border-accent hover:text-accent',
};
---

<Tag href={href} data-magnetic class:list={[base, sizes[size], variants[variant], className]} {...rest}>
  <slot />
</Tag>
