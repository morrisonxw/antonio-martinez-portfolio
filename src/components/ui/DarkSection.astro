---
interface Props {
  class?: string;
  as?: keyof HTMLElementTagNameMap;
  'data-reveal'?: boolean | string;
}

const { class: className = '', as: Tag = 'section', ...rest } = Astro.props;
---

{
  /*
    El sitio entero es oscuro ahora (ver tokens.css), así que bg-paper
    text-ink acá es redundante con el fondo de <body> — se deja explícito
    de todas formas porque esta sección es full-bleed y puede sentarse
    sobre markup con su propio color heredado más arriba en el árbol.
  */
}
<Tag class:list={['w-full bg-paper text-ink', className]} {...rest}>
  <slot />
</Tag>
