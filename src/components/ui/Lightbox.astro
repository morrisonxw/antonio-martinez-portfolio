---
// Lightbox de las imágenes y videos de un case study. En vez de que cada
// componente (Figure, BeforeAfter, cover, <img>/<video> crudo en MDX)
// implemente su propio zoom, este componente vive una sola vez en
// CaseStudyLayout y delega clicks/teclado sobre cualquier <img> o <video>
// dentro de <article> — así cualquier imagen o video del proyecto queda
// ampliable sin tocar esos componentes ni el contenido MDX.
import { t, type Locale } from '../../i18n/ui';

const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<div
  id="lightbox"
  data-state="closed"
  data-expand-label={t(locale, 'lightbox.expand')}
  class="fixed inset-0 z-[80] pointer-events-none data-[state=open]:pointer-events-auto"
  role="dialog"
  aria-modal="true"
  aria-label={t(locale, 'lightbox.expand')}
>
  <div
    data-lightbox-backdrop
    data-state="closed"
    class="absolute inset-0 bg-ink/90 opacity-0 transition-opacity duration-300 ease-out data-[state=open]:opacity-100"
  >
  </div>
  <button
    type="button"
    data-lightbox-close
    aria-label={t(locale, 'lightbox.close')}
    class="absolute right-4 top-4 z-10 flex h-9 w-9 items-center justify-center rounded-full border border-paper/30 text-paper transition-colors hover:border-accent hover:text-accent sm:right-6 sm:top-6"
  >
    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" class="h-4 w-4">
      <path d="M6 6l12 12M18 6L6 18" />
    </svg>
  </button>
  <div
    data-lightbox-content
    data-state="closed"
    class="flex h-full w-full scale-95 items-center justify-center p-4 opacity-0 transition-all duration-300 ease-out data-[state=open]:scale-100 data-[state=open]:opacity-100 sm:p-10"
  >
    <img data-lightbox-image src="" alt="" class="hidden max-h-full max-w-full rounded-lg object-contain" />
    <video data-lightbox-video class="hidden max-h-full max-w-full rounded-lg" loop playsinline controls></video>
  </div>
</div>

<script>
  function setupLightbox() {
    const lightbox = document.getElementById('lightbox');
    const backdrop = lightbox?.querySelector<HTMLElement>('[data-lightbox-backdrop]');
    const content = lightbox?.querySelector<HTMLElement>('[data-lightbox-content]');
    const closeBtn = lightbox?.querySelector<HTMLElement>('[data-lightbox-close]');
    const imgEl = lightbox?.querySelector<HTMLImageElement>('[data-lightbox-image]');
    const videoEl = lightbox?.querySelector<HTMLVideoElement>('[data-lightbox-video]');
    const article = document.querySelector('article');
    if (!lightbox || !backdrop || !content || !closeBtn || !imgEl || !videoEl || !article) return;

    let lastFocused: HTMLElement | null = null;

    function setState(state: 'open' | 'closed') {
      lightbox!.dataset.state = state;
      backdrop!.dataset.state = state;
      content!.dataset.state = state;
    }

    function openImage(src: string, alt: string) {
      lastFocused = document.activeElement as HTMLElement;
      videoEl!.pause();
      videoEl!.removeAttribute('src');
      videoEl!.classList.add('hidden');
      imgEl!.src = src;
      imgEl!.alt = alt;
      imgEl!.classList.remove('hidden');
      setState('open');
      document.documentElement.classList.add('overflow-hidden');
      document.addEventListener('keydown', onKeydown);
      closeBtn!.focus();
    }

    function openVideo(src: string) {
      lastFocused = document.activeElement as HTMLElement;
      imgEl!.removeAttribute('src');
      imgEl!.classList.add('hidden');
      videoEl!.src = src;
      videoEl!.muted = false;
      videoEl!.classList.remove('hidden');
      videoEl!.play().catch(() => {
        // Si el navegador bloquea el autoplay con audio, el usuario ya tiene
        // los controles nativos visibles para darle play manualmente.
      });
      setState('open');
      document.documentElement.classList.add('overflow-hidden');
      document.addEventListener('keydown', onKeydown);
      closeBtn!.focus();
    }

    function close() {
      setState('closed');
      videoEl!.pause();
      document.documentElement.classList.remove('overflow-hidden');
      document.removeEventListener('keydown', onKeydown);
      lastFocused?.focus();
    }

    function onKeydown(e: KeyboardEvent) {
      if (e.key === 'Escape') close();
    }

    closeBtn.addEventListener('click', close);
    backdrop.addEventListener('click', close);
    // El wrapper de contenido cubre toda la pantalla (para centrar la imagen/video),
    // así que un click en el área "vacía" alrededor del media cae sobre este
    // elemento y no sobre el backdrop de abajo. Se cierra igual, salvo que el
    // click haya sido directamente sobre la imagen o el video.
    content.addEventListener('click', (e) => {
      if (e.target === content) close();
    });

    const expandLabel = lightbox.dataset.expandLabel ?? 'Ampliar imagen';

    article.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
      img.classList.add('cursor-zoom-in');
      img.tabIndex = 0;
      img.setAttribute('role', 'button');
      if (!img.getAttribute('aria-label')) {
        img.setAttribute('aria-label', img.alt || expandLabel);
      }
      img.addEventListener('click', () => openImage(img.currentSrc || img.src, img.alt));
      img.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openImage(img.currentSrc || img.src, img.alt);
        }
      });
    });

    article.querySelectorAll<HTMLVideoElement>('video').forEach((video) => {
      const label = video.closest('figure')?.querySelector('figcaption')?.textContent?.trim() || expandLabel;
      video.classList.add('cursor-zoom-in');
      video.tabIndex = 0;
      video.setAttribute('role', 'button');
      video.setAttribute('aria-label', label);
      video.addEventListener('click', () => openVideo(video.currentSrc || video.src));
      video.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          openVideo(video.currentSrc || video.src);
        }
      });
    });
  }

  document.addEventListener('astro:page-load', setupLightbox);
</script>
