---
import type { ProjectEntry } from '../../lib/content-types';
import { t, type Locale } from '../../i18n/ui';
import { projectHref } from '../../i18n/paths';

interface Props {
  prev?: ProjectEntry;
  next?: ProjectEntry;
}

const { prev, next } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<nav aria-label={t(locale, 'projectNav.label')} class="grid grid-cols-1 gap-4 border-t border-border pt-8 sm:grid-cols-2">
  {
    prev ? (
      <a href={projectHref(locale, prev.id)} class="group">
        <span class="text-xs font-medium uppercase tracking-wide text-ink-muted">{t(locale, 'projectNav.prev')}</span>
        <p class="mt-1 font-display text-lg font-semibold tracking-tightest text-ink group-hover:text-accent">{prev.data.title}</p>
      </a>
    ) : (
      <span />
    )
  }
  {
    next && (
      <a href={projectHref(locale, next.id)} class="text-right group sm:text-right">
        <span class="text-xs font-medium uppercase tracking-wide text-ink-muted">{t(locale, 'projectNav.next')}</span>
        <p class="mt-1 font-display text-lg font-semibold tracking-tightest text-ink group-hover:text-accent">{next.data.title}</p>
      </a>
    )
  }
</nav>
