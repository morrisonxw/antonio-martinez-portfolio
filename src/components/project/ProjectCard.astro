---
import { Image } from 'astro:assets';
import Tag from '../ui/Tag.astro';
import type { ProjectEntry } from '../../lib/content-types';
import type { Locale } from '../../i18n/ui';
import { projectHref } from '../../i18n/paths';

interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const { title, summary, cover, thumbnail, coverAlt, tags, year, yearLabel, externalUrl } = project.data;
const locale = (Astro.currentLocale ?? 'es') as Locale;
const href = externalUrl ?? projectHref(locale, project.id);
---

<a
  href={href}
  target={externalUrl ? '_blank' : undefined}
  rel={externalUrl ? 'noopener noreferrer' : undefined}
  aria-labelledby={`project-card-${project.id}`}
  class="group block"
  data-reveal
>
  <div class="overflow-hidden rounded-2xl bg-paper-muted">
    <Image
      src={thumbnail ?? cover}
      alt={coverAlt}
      width={800}
      height={533}
      class="aspect-[3/2] w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.03]"
    />
  </div>
  <div class="mt-5 flex items-start justify-between gap-4 sm:mt-6">
    <div>
      {
        /*
          min-h reserva 2 líneas de título (2 × line-height de text-2xl) para
          que, cuando una card vecina en la misma fila de la grilla tenga un
          título más corto (1 línea) o más largo (2 líneas), el summary de
          ambas siga arrancando a la misma altura.
        */
      }
      <h3
        id={`project-card-${project.id}`}
        class="flex min-h-[4rem] items-start gap-1.5 font-display text-2xl font-bold tracking-tightest text-ink group-hover:text-accent"
      >
        {title}
        {externalUrl && <span class="text-lg">↗</span>}
      </h3>
      <p class="mt-2 text-base text-ink-muted">{summary}</p>
    </div>
    {!externalUrl && <span class="shrink-0 text-sm text-ink-muted">{yearLabel ?? year}</span>}
  </div>
  {
    tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-2">
        {tags.map((tag) => <Tag>{tag}</Tag>)}
      </div>
    )
  }
</a>
