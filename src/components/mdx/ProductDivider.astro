---
interface Props {
  eyebrow: string;
  label: string;
}

const { eyebrow, label } = Astro.props;
---

{
  /*
    Contraste verificado (WCAG 2.1 AA, luminancia relativa) contra los
    tokens declarados en tokens.css:
    - ink sobre accent-muted:    17.2:1
    - accent sobre accent-muted:  5.6:1
  */
}
<div class="relative my-14 -mx-6 rounded-md bg-accent-muted px-6 py-6 sm:-mx-8 sm:px-8" data-reveal>
  <p class="text-xs font-semibold uppercase tracking-[0.2em] text-accent">{eyebrow}</p>
  <p class="mt-1 font-display text-xl font-bold tracking-tightest text-ink sm:text-2xl">{label}</p>
</div>
