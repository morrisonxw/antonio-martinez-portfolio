---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { t, type Locale } from '../../i18n/ui';

interface Props {
  before: ImageMetadata;
  beforeAlt: string;
  after: ImageMetadata;
  afterAlt: string;
}

const { before, beforeAlt, after, afterAlt } = Astro.props;
const locale = (Astro.currentLocale ?? 'es') as Locale;
---

<div class="my-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
  <figure>
    <Image src={before} alt={beforeAlt} width={800} class="w-full rounded-xl" />
    <figcaption class="mt-2 text-sm text-ink-muted">{t(locale, 'beforeAfter.before')}</figcaption>
  </figure>
  <figure>
    <Image src={after} alt={afterAlt} width={800} class="w-full rounded-xl" />
    <figcaption class="mt-2 text-sm text-ink-muted">{t(locale, 'beforeAfter.after')}</figcaption>
  </figure>
</div>
