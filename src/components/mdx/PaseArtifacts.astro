---
import PaseProcessMap from './PaseProcessMap.astro';
interface Props { kind: 'personas' | 'journey' | 'employee' | 'process' | 'blueprint' | 'measurement'; locale?: 'es' | 'en'; }
const { kind, locale = 'es' } = Astro.props;
const t = (es: string, en: string) => locale === 'en' ? en : es;
const cells = (es: string[], en: string[]) => locale === 'en' ? en : es;
const personas = [
  [t('Analista del proveedor logístico', 'Logistics provider analyst'), t('Cobrar lo correspondiente sin comprometer la operación.', 'Receive the correct payment without disrupting operations.'), t('Revisar servicios recientes y entender qué se reconoce.', 'Review recent services and understand what is recognised.'), t('Revisión acumulada, plantillas confusas e histórico incompleto.', 'Accumulated review, confusing templates and incomplete history.')],
  [t('Analista de contabilidad', 'Accounting analyst'), t('Gestionar diferencias y conservar el control del proceso.', 'Manage discrepancies and retain process ownership.'), t('Resolver con evidencia y consultar a operaciones cuando hace falta.', 'Resolve with evidence and consult operations when needed.'), t('Reclamos concentrados, complementarias y respuestas difíciles de seguir.', 'Concentrated claims, supplementary statements and hard-to-follow responses.')],
  [t('Analista de operaciones', 'Operations analyst'), t('Aportar información sobre los servicios ejecutados.', 'Provide information about executed services.'), t('Saber cómo responder a contabilidad y qué responsabilidad conserva.', 'Understand how to respond to accounting and the scope of responsibility.'), t('Dudas sobre el nuevo rol y cómo trasladar información.', 'Uncertainty about the new role and how to share information.')],
];
const stages = cells(['Consultar', 'Marcar diferencia', 'Analizar', 'Resolver', 'Comprender respuesta', 'Continuar desacuerdo'], ['Consult', 'Report discrepancy', 'Analyse', 'Resolve', 'Understand response', 'Continue disagreement']);
const journey = [
  [t('Acción del proveedor', 'Provider action'), ...cells(['Consulta servicios por fecha.', 'Contrasta registros y marca conceptos.', 'Espera el análisis del caso.', 'Espera la respuesta del servicio.', 'Lee motivo y referencias.', 'Usa reclamos tradicionales si discrepa.'], ['Consults services by date.', 'Compares records and flags concepts.', 'Waits for case analysis.', 'Waits for the service response.', 'Reads reason and references.', 'Uses traditional claims if still disagreeing.'])],
  [t('Contacto y evidencia', 'Touchpoint and evidence'), ...cells(['Histórico de PASE.', 'Interfaz de revisión diaria.', 'Diferencia en revisión.', 'Respuesta de PASE.', 'Contrato o registro referenciado.', 'Reclamos y trazabilidad de PASE.'], ['PASE history.', 'Daily-review interface.', 'Discrepancy under review.', 'PASE response.', 'Referenced agreement or record.', 'Claims and PASE traceability.'])],
  [t('Fricción', 'Friction'), ...cells(['El monitoreo anterior no conservaba histórico.', 'Las plantillas anteriores eran confusas.', 'Evidencia insuficiente para automatizar.', 'Una sugerencia incierta confundía al analista.', 'El motivo debe permitir contrastar la decisión.', 'Cambiar de sistema para continuar la gestión.'], ['Previous monitoring retained no history.', 'Previous templates were confusing.', 'Insufficient evidence for automation.', 'Uncertain suggestions confused the analyst.', 'The reason must support checking the decision.', 'Change systems to continue handling.'])],
  [t('Respuesta del servicio', 'Service response'), ...cells(['Histórico consultable.', '48 h hábiles para reportar.', 'Derivación humana si no cumple condiciones.', 'Otras 48 h hábiles para responder.', 'Explicación y fuentes contrastables.', 'Capacitación y ayuda dentro de ambos sistemas.'], ['Consultable history.', '48 business hours to report.', 'Human handling if conditions are not met.', 'Another 48 business hours to respond.', 'Explanation and checkable sources.', 'Training and in-app help in both systems.'])],
  [t('Momento crítico', 'Critical moment'), ...cells(['Recuperar contexto sin depender de memoria.', 'Expresar una diferencia comprensiblemente.', 'Contar con evidencia suficiente.', 'Recibir una decisión responsable.', 'Entender qué se reconoce y por qué.', 'Continuar sin perder la historia del caso.'], ['Recover context without relying on memory.', 'Express a discrepancy clearly.', 'Have sufficient evidence.', 'Receive an accountable decision.', 'Understand what is recognised and why.', 'Continue without losing case history.'])],
];
const employeeStages = cells(['Recibir', 'Investigar', 'Consultar', 'Decidir'], ['Receive', 'Investigate', 'Consult', 'Decide']);
const employee = [
  [t('Tarea contable', 'Accounting task'), ...cells(['Recibir lo no resuelto automáticamente.', 'Buscar fuentes y contexto.', 'Consultar a operaciones si necesita información.', 'Determinar respuesta y conservar responsabilidad.'], ['Receive cases not resolved automatically.', 'Find sources and context.', 'Consult operations if information is needed.', 'Determine response and retain responsibility.'])],
  [t('Fricción previa', 'Previous friction'), ...cells(['Hasta unos 20.000 reclamos por ventana, sobre todo Last Mile.', 'Reconstruir servicios antiguos y plantillas.', 'Intermediación para reunir evidencia.', 'Complementarias y nuevas disputas.'], ['Up to about 20,000 claims per window, mainly Last Mile.', 'Reconstruct older services and templates.', 'Intermediate handoffs to obtain evidence.', 'Supplementary statements and new disputes.'])],
  [t('Diseño implementado', 'Implemented design'), ...cells(['Revisión durante el ciclo activo.', 'Asistencia hacia evidencia, no una resolución sugerida.', 'Contabilidad canaliza; operaciones aporta datos.', 'Respuesta con motivo y referencias.'], ['Review during the active cycle.', 'Assistance towards evidence, not suggested decisions.', 'Accounting channels requests; operations supplies data.', 'Response with reason and references.'])],
  [t('Aprendizaje del diseño', 'Design learning'), ...cells(['Se probó viabilidad de revisión diaria.', 'Los testeos mostraron confusión ante sugerencias.', 'Dudas operativas motivaron textos y capacitación.', 'La respuesta debe explicar el criterio de decisión.'], ['Daily-review feasibility was tested.', 'Tests showed confusion with suggestions.', 'Operations questions led to revised copy and training.', 'The response needs to explain the decision criteria.'])],
];
type BlueprintRow = { label: string; entries: string[]; lineAfter?: string };
const blueprint: BlueprintRow[] = [
  { label: t('Evidencia y contacto', 'Evidence and touchpoint'), entries: cells(['Servicios y ayuda en PASE.', 'Diferencias marcadas.', 'Diferencia en revisión.', 'Respuesta del proceso.', 'Motivo y referencias.', 'Reclamos con trazabilidad.'], ['Services and PASE help.', 'Flagged discrepancies.', 'Discrepancy under review.', 'Process response.', 'Reason and references.', 'Claims with traceability.']) },
  { label: t('Acciones del proveedor', 'Provider actions'), entries: journey[0].slice(1), lineAfter: t('Línea de interacción: proveedor ↔ servicio', 'Line of interaction: provider ↔ service') },
  { label: t('Frontstage: experiencia visible', 'Frontstage: visible experience'), entries: cells(['Histórico por fecha.', '48 h hábiles de reporte.', 'Revisión de la diferencia.', 'Otras 48 h hábiles de respuesta.', 'Explicación de aprobación o rechazo.', 'Orientación al canal tradicional.'], ['History by date.', '48 business hours to report.', 'Discrepancy review.', 'Another 48 business hours to respond.', 'Approval or rejection explanation.', 'Guidance to the traditional channel.']), lineAfter: t('Línea de visibilidad: experiencia visible / trabajo interno', 'Line of visibility: visible experience / internal work') },
  { label: t('Backstage: trabajo interno', 'Backstage: internal work'), entries: cells(['Disponibilidad de registros.', 'Recepción de diferencias.', 'IA contrasta y aplica condiciones.', 'Automático o contabilidad con apoyo de operaciones.', 'Registro de resolución con contexto.', 'Continuidad fuera de PASE.'], ['Records made available.', 'Discrepancies received.', 'AI compares and applies conditions.', 'Automatic or accounting with operations support.', 'Resolution recorded with context.', 'Continuation outside PASE.']), lineAfter: t('Línea de interacción interna: contabilidad ↔ operaciones y soporte', 'Line of internal interaction: accounting ↔ operations and support') },
  { label: t('Soporte e interdependencias', 'Support and dependencies'), entries: cells(['Sistemas operativos.', 'Acuerdos de PACTO aceptados.', 'Contratos, depósitos, GPS y otras fuentes.', 'Desarrollo implementa condiciones; operaciones aporta información.', 'Fuentes contractuales y operativas.', 'PASE y reclamos tradicionales.'], ['Operational systems.', 'Accepted PACTO agreements.', 'Agreements, depots, GPS and other sources.', 'Engineering implements conditions; operations supplies information.', 'Contractual and operational sources.', 'PASE and traditional claims.']) },
  { label: t('Puntos de falla', 'Failure points'), entries: cells(['Datos tardíos o fallas.', 'Concepto incomprensible o vencimiento.', 'Condiciones no cumplidas.', 'Confusión ante sugerencias o responsabilidades.', 'Desacuerdo con la respuesta.', 'Transición entre sistemas.'], ['Late data or failures.', 'Unclear concept or expiry.', 'Conditions not met.', 'Confusion with suggestions or responsibilities.', 'Disagreement with response.', 'Transition between systems.']) },
  { label: t('Recuperación del servicio', 'Service recovery'), entries: cells(['Extensión manual ante fallas.', 'Ayuda integrada y capacitación.', 'Revisión humana.', 'Textos, formación y búsqueda de evidencia.', 'Explicación y referencias.', 'Ayuda integrada y trazabilidad de PASE.'], ['Manual extension after failures.', 'In-app help and training.', 'Human review.', 'Copy, training and evidence search.', 'Explanation and references.', 'In-app training and PASE traceability.']) },
];
const outcomes = [
  ['70 %', t('Menos reclamos totales', 'Fewer total claims'), t('Reducción del volumen total de reclamos. Un servicio puede generar más de un reclamo.', 'Reduction in total claim volume. One service may generate more than one claim.')],
  ['100 %', t('Respuestas dentro del plazo', 'Responses within deadline'), t('Durante el primer mes y medio de seguimiento del proyecto, con extensiones excepcionales ante fallas.', 'During the first month and a half of project follow-up, with exceptional extensions after failures.')],
];
const supportMetrics = [
  [t('Dedicación del equipo', 'Team effort'), t('2–3 semanas mensuales → unas 2 h diarias', '2–3 weeks per month → about 2 hours daily'), t('Estimación del equipo sobre la dedicación a la gestión de reclamos.', 'Team estimate of the effort spent handling claims.')],
  [t('Impacto económico esperado', 'Expected economic impact'), t('Potencial de USD 7 millones anuales', 'Potential of USD 7 million annually'), t('Hipótesis del caso de negocio: evitar pérdidas mediante la conciliación oportuna.', 'Business-case hypothesis: prevent losses through timely reconciliation.')],
  [t('Continuidad entre canales', 'Continuity across channels'), t('Menos reconstrucción del caso', 'Less case reconstruction'), t('Hipótesis de impacto esperado: conservar el contexto al continuar en reclamos tradicionales.', 'Expected-impact hypothesis: retain context when continuing through traditional claims.')],
];
---
<figure class="not-prose media-bleed my-12 pase-artifact" data-pase-artifact={kind}>
  {kind === 'personas' && <>
    <div class="grid gap-6 md:grid-cols-3">{personas.map(([role, task, need, friction]) => <section class="border-t-2 border-ink pt-5">
      <p class="text-xs uppercase tracking-wide text-ink-muted">{t('Perfil de trabajo', 'Work profile')}</p>
      <h3 class="mt-2 font-display text-xl font-semibold text-ink">{role}</h3>
      <dl class="mt-4 space-y-4 text-sm leading-relaxed">{[[t('Objetivo', 'Goal'), task], [t('Necesidad', 'Need'), need], [t('Fricción', 'Friction'), friction]].map(([label, value]) => <div><dt class="font-semibold text-ink">{label}</dt><dd class="mt-1 text-ink-muted">{value}</dd></div>)}</dl>
    </section>)}</div>
    <figcaption>{t('Tres perfiles de trabajo con objetivos distintos: revisar servicios, resolver diferencias y aportar contexto operativo.', 'Three work profiles with distinct goals: review services, resolve discrepancies and provide operational context.')}</figcaption>
  </>}
  {(kind === 'journey' || kind === 'employee') && <>
    <p class="mb-4 text-sm text-ink">{kind === 'journey'
      ? t('Actor: analista MLP. Escenario: diferencia durante el ciclo activo. Objetivo: cobrar lo correspondiente sin comprometer la operación.', 'Actor: provider analyst. Scenario: discrepancy during the active cycle. Goal: receive the correct payment without disrupting operations.')
      : t('Actor: analista de contabilidad. Escenario: diferencia que no puede resolverse automáticamente. Objetivo: responder con evidencia y conservar el control.', 'Actor: accounting analyst. Scenario: a discrepancy that cannot be resolved automatically. Goal: respond with evidence and retain control.')}</p>
    <div class="table-scroll" tabindex="0" role="region" aria-label={kind === 'journey' ? t('Journey del proveedor', 'Provider journey') : t('Recorrido de contabilidad', 'Accounting journey')}>
      <table class:list={['journey', kind === 'employee' && 'employee']}>
        <caption class="sr-only">{kind === 'journey' ? t('Customer Journey del proveedor', 'Provider Customer Journey') : t('Employee Journey de contabilidad', 'Accounting Employee Journey')}</caption>
        <thead><tr><th scope="col">{t('Dimensión', 'Dimension')}</th>{(kind === 'journey' ? stages : employeeStages).map(s => <th scope="col">{s}</th>)}</tr></thead>
        <tbody>{(kind === 'journey' ? journey : employee).map(([label, ...values]) => <tr><th scope="row">{label}</th>{values.map(value => <td>{value}</td>)}</tr>)}</tbody>
      </table>
    </div>
    <figcaption>{t('El recorrido conecta las tareas de cada etapa con las fricciones y el apoyo que ofrece el servicio.', 'The journey connects tasks at each stage with friction and the support provided by the service.')}</figcaption>
  </>}
  {kind === 'process' && <>
    <p class="mb-4 text-sm text-ink">{t('Modelo funcional del alcance implementado. Contabilidad conserva la responsabilidad de los casos humanos; operaciones aporta información.', 'Functional model of the implemented scope. Accounting retains responsibility for human-handled cases; operations provides information.')}</p>
    <PaseProcessMap locale={locale} />
    <figcaption>{t('La automatización y la revisión contable convergen en una respuesta con contexto. Si persiste el desacuerdo, la gestión continúa en reclamos tradicionales.', 'Automation and accounting review converge in a contextual response. Persistent disagreement continues through traditional claims.')}</figcaption>
  </>}
  {kind === 'blueprint' && <>
    {[0, 3].map(offset => <section class="blueprint-panel">
      <h3 class="mb-4 font-display text-lg font-semibold text-ink">{offset === 0 ? t('A. Consulta, reporte y análisis', 'A. Consultation, reporting and analysis') : t('B. Resolución, respuesta y continuidad', 'B. Resolution, response and continuity')}</h3>
      <div class="table-scroll" tabindex="0" role="region" aria-label={t('Blueprint del servicio', 'Service blueprint') + (offset === 0 ? ' A' : ' B')}>
        <table class="blueprint">
          <caption class="sr-only">{t('Blueprint del servicio PASE', 'PASE service blueprint')} {offset === 0 ? 'A' : 'B'}</caption>
          <thead><tr><th scope="col">{t('Capa del servicio', 'Service layer')}</th>{stages.slice(offset, offset + 3).map((s, i) => <th scope="col">{offset + i + 1}. {s}</th>)}</tr></thead>
          <tbody>{blueprint.map(row => <>
            <tr><th scope="row">{row.label}</th>{row.entries.slice(offset, offset + 3).map(value => <td>{value}</td>)}</tr>
            {row.lineAfter && <tr class="blueprint-line"><th colspan="4">{row.lineAfter}</th></tr>}
          </>)}</tbody>
        </table>
      </div>
    </section>)}
    <figcaption>{t('La lectura por columnas sigue el recorrido del proveedor; la lectura por filas muestra qué sucede frente a él, qué resuelven los equipos y cómo se recupera el servicio ante una falla.', 'Columns follow the provider journey; rows show the visible experience, internal work and service recovery after failures.')}</figcaption>
  </>}
  {kind === 'measurement' && <>
    <section aria-label={t('Servicios reclamados antes y después', 'Services with claims before and after')}>
      <h3 class="font-display text-xl font-semibold text-ink">{t('Servicios reclamados: aproximadamente 30 % → 10 %', 'Services with claims: approximately 30% → 10%')}</h3>
      <p class="mt-2 text-sm text-ink-muted">{t('Mismos proveedores antes y después. Disminución de 20 puntos porcentuales.', 'Same providers before and after. A decrease of 20 percentage points.')}</p>
      <div class="chart mt-6" role="img" aria-label={t('Escala de cero a cien por ciento. Antes: aproximadamente treinta por ciento. Con PASE: aproximadamente diez por ciento.', 'Scale from zero to one hundred percent. Before: approximately thirty percent. With PASE: approximately ten percent.')}>
        {[30, 10].map((value, i) => <div class="chart-row">
          <span>{i === 0 ? t('Antes', 'Before') : t('Con PASE', 'With PASE')}</span>
          <div class="bar-track"><div class:list={['bar', i === 1 && 'after']} style={`width: ${value}%`}></div></div>
          <strong>{value} %</strong>
        </div>)}
        <div class="chart-scale" aria-hidden="true"><span>0 %</span><span>50 %</span><span>100 %</span></div>
      </div>
      <p class="mt-4 text-sm text-ink-muted">{t('El indicador compara la proporción de servicios reclamados por los mismos proveedores antes y después de PASE.', 'The indicator compares the share of services with claims for the same providers before and after PASE.')}</p>
    </section>
    <div class="mt-8 grid gap-6 sm:grid-cols-2">{outcomes.map(([value, label, note]) => <section class="border-t border-border pt-5"><p class="font-display text-4xl font-bold text-ink">{value}</p><h3 class="mt-2 font-semibold text-ink">{label}</h3><p class="mt-2 text-sm leading-relaxed text-ink-muted">{note}</p></section>)}</div>
    <div class="table-scroll mt-8" tabindex="0" role="region" aria-label={t('Dedicación del equipo e impacto esperado', 'Team effort and expected impact')}>
      <table class="metrics"><caption class="sr-only">{t('Eficiencia e impacto esperado', 'Efficiency and expected impact')}</caption>
        <thead><tr>{[t('Dimensión', 'Dimension'), t('Resultado o expectativa', 'Result or expectation'), t('Alcance', 'Scope')].map(label => <th scope="col">{label}</th>)}</tr></thead>
        <tbody>{supportMetrics.map(([label, value, note]) => <tr><th scope="row">{label}</th><td>{value}</td><td>{note}</td></tr>)}</tbody>
      </table>
    </div>
    <figcaption>{t('Los indicadores muestran el seguimiento inicial del proyecto. El potencial económico y la continuidad entre canales expresan el impacto esperado.', 'Indicators reflect initial project follow-up. Economic potential and continuity across channels describe expected impact.')}</figcaption>
  </>}
</figure>
<style>
  figcaption { margin-top: 1rem; color: var(--ink-muted); font-size: .875rem; line-height: 1.6; }
  .table-scroll { overflow-x: auto; }
  .table-scroll:focus-visible { outline: 2px solid var(--accent-strong); outline-offset: 4px; }
  table { width: 100%; border-collapse: collapse; font-size: .875rem; line-height: 1.6; }
  .journey { min-width: 1180px; } .employee { min-width: 900px; }
  .blueprint { min-width: 850px; } .metrics { min-width: 640px; }
  th, td { padding: 1rem; vertical-align: top; text-align: left; border-bottom: 1px solid var(--border); }
  thead { background: var(--paper-muted); }
  th { color: var(--ink); font-weight: 600; } td { color: var(--ink-soft); }
  tbody th { min-width: 145px; } .blueprint th:first-child { width: 22%; }
  .blueprint-line th { border-block: 2px dashed var(--ink-muted); background: var(--accent-muted); font-size: .75rem; }
  .blueprint-panel + .blueprint-panel { margin-top: 2rem; }
  .chart-row { display: grid; grid-template-columns: 5.5rem 1fr 3.5rem; gap: .75rem; align-items: center; font-size: .875rem; color: var(--ink); margin-bottom: 1rem; }
  .bar-track { background: var(--paper-muted); height: 1.75rem; }
  .bar { background: var(--ink-muted); height: 100%; } .bar.after { background: var(--accent-strong); }
  .chart-scale { display: flex; justify-content: space-between; margin-left: 6.25rem; margin-right: 4.25rem; color: var(--ink-muted); font-size: .75rem; }
</style>
