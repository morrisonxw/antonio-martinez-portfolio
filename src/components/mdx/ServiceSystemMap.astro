---
interface Props {
  locale?: 'es' | 'en';
  caption?: string;
}

const { locale = 'es', caption } = Astro.props;
const en = locale === 'en';
---

<figure class="not-prose my-10" data-reveal>
  <div class="overflow-x-auto rounded-2xl border border-border/60 bg-paper p-3 sm:p-5">
    <svg viewBox="0 0 960 470" class="block h-auto min-w-[760px] w-full" role="img" aria-label={en ? 'Service system map. The SME interacts with the human advisor. AI supports the advisor behind the scenes, enabled by risk, data governance, compliance, and leadership.' : 'Mapa del sistema de servicio. La pyme interactúa con la asesora. La IA apoya a la asesora tras escena, con habilitación de riesgo, gobierno de datos, compliance y liderazgo.'}>
      <defs>
        <marker id="system-arrow-orange" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M1 1 L7 4 L1 7" class="fill-none stroke-accent" stroke-width="1.5" /></marker>
        <marker id="system-arrow-gray" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M1 1 L7 4 L1 7" class="fill-none stroke-ink-muted" stroke-width="1.5" /></marker>
      </defs>
      <text x="36" y="34" class="fill-ink text-[11px] font-semibold tracking-[0.12em]">{en ? 'SERVICE SYSTEM · ROLES AND INFORMATION FLOWS' : 'SISTEMA DE SERVICIO · ROLES Y FLUJOS DE INFORMACIÓN'}</text>

      <line x1="308" y1="190" x2="376" y2="190" class="stroke-accent" stroke-width="2.5" marker-end="url(#system-arrow-orange)" />
      <line x1="376" y1="222" x2="308" y2="222" class="stroke-ink-muted" stroke-width="1.8" marker-end="url(#system-arrow-gray)" />
      <text x="342" y="170" text-anchor="middle" class="fill-ink-muted text-[10px]">{en ? 'conversation' : 'conversación'}</text>
      <text x="342" y="246" text-anchor="middle" class="fill-ink-muted text-[10px]">{en ? 'goals and context' : 'objetivos y contexto'}</text>

      <line x1="587" y1="190" x2="650" y2="190" class="stroke-accent" stroke-width="2.5" marker-end="url(#system-arrow-orange)" />
      <line x1="650" y1="222" x2="587" y2="222" class="stroke-ink-muted" stroke-width="1.8" marker-end="url(#system-arrow-gray)" />
      <text x="618" y="170" text-anchor="middle" class="fill-ink-muted text-[10px]">{en ? 'review and adjust' : 'revisión y ajuste'}</text>
      <text x="618" y="246" text-anchor="middle" class="fill-ink-muted text-[10px]">{en ? 'signals and options' : 'señales y alternativas'}</text>

      <rect x="44" y="112" width="264" height="164" rx="16" class="fill-paper stroke-border" stroke-width="1.5" />
      <text x="66" y="143" class="fill-ink-muted text-[10px] font-semibold tracking-[0.12em]">{en ? 'SME CLIENT' : 'CLIENTE PYME'}</text>
      <text x="66" y="179" class="fill-ink text-[21px] font-bold">{en ? 'Carlos' : 'Carlos'}</text>
      <text x="66" y="208" class="fill-ink-muted text-[12px]">{en ? 'Shares a growth decision' : 'Expone una decisión de crecimiento'}</text>
      <text x="66" y="231" class="fill-ink-muted text-[12px]">{en ? 'and chooses what data to share.' : 'y elige qué información compartir.'}</text>
      <text x="66" y="258" class="fill-accent-strong text-[10px] font-semibold">{en ? 'No direct interaction with Wanda' : 'No interactúa directamente con Wanda'}</text>

      <rect x="376" y="98" width="211" height="192" rx="16" class="fill-ink" />
      <text x="398" y="133" class="fill-paper-muted text-[10px] font-semibold tracking-[0.12em]">{en ? 'HUMAN ADVISOR' : 'ASESORA HUMANA'}</text>
      <text x="398" y="170" class="fill-paper text-[21px] font-bold">Laura</text>
      <text x="398" y="202" class="fill-paper text-[12px]">{en ? 'Interprets · asks' : 'Interpreta · pregunta'}</text>
      <text x="398" y="224" class="fill-paper text-[12px]">{en ? 'decides · recommends' : 'decide · recomienda'}</text>
      <text x="398" y="258" class="fill-accent-muted text-[10px] font-semibold">{en ? 'Owns the client relationship' : 'Responde por la relación'}</text>

      <rect x="650" y="112" width="264" height="164" rx="16" class="fill-accent-muted/60 stroke-accent" stroke-width="1.5" />
      <text x="672" y="143" class="fill-accent-strong text-[10px] font-semibold tracking-[0.12em]">{en ? 'ADVISOR WORKSPACE' : 'ESPACIO DEL ASESOR'}</text>
      <text x="672" y="179" class="fill-ink text-[21px] font-bold">Wanda</text>
      <text x="672" y="208" class="fill-ink-muted text-[12px]">{en ? 'Organizes signals and sources' : 'Organiza señales y fuentes'}</text>
      <text x="672" y="231" class="fill-ink-muted text-[12px]">{en ? 'prepares options and flags delays' : 'prepara alternativas y alerta demoras'}</text>
      <text x="672" y="258" class="fill-ink text-[10px] font-semibold">{en ? 'No autonomous client decisions' : 'No decide por la pyme'}</text>

      <path d="M480 320 V348" fill="none" class="stroke-ink-muted" stroke-width="1.5" stroke-dasharray="5 5" marker-end="url(#system-arrow-gray)" />
      <rect x="112" y="354" width="736" height="78" rx="14" class="fill-paper-muted stroke-border" stroke-width="1.2" />
      <text x="136" y="383" class="fill-ink text-[11px] font-bold tracking-[0.1em]">{en ? 'ENABLING CONDITIONS' : 'CONDICIONES HABILITADORAS'}</text>
      <text x="136" y="407" class="fill-ink-muted text-[12px]">{en ? 'Data governance · Compliance · Risk · Credit operations · Commercial leadership' : 'Gobierno de datos · Compliance · Riesgo · Operaciones de crédito · Liderazgo comercial'}</text>
      <text x="852" y="344" text-anchor="end" class="fill-ink-muted text-[9px]">{en ? 'permissions · oversight · integration' : 'permisos · supervisión · integración'}</text>
    </svg>
  </div>
  {caption && <figcaption class="mt-3 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
