---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  // `full` ocupa todo el ancho de la prosa (default). `md`/`sm` limitan el
  // ancho para recortes de modales o pantallas móviles, que se ven forzados
  // si se estiran a 42rem.
  size?: 'full' | 'md' | 'sm';
  // Coloca la imagen sobre un fondo de superficie suave: útil para recortes
  // de componentes flotantes (modales) que no tienen un marco propio.
  framed?: boolean;
}

const { src, alt, caption, size = 'full', framed = false } = Astro.props;
const widthClass = { full: '', md: 'mx-auto max-w-xl', sm: 'mx-auto max-w-xs' }[size];
---

<figure class:list={['my-10', size === 'full' && 'media-bleed']} data-reveal>
  {
    framed ? (
      <div class="rounded-2xl bg-paper-muted px-4 py-8 sm:px-10 sm:py-12">
        <Image src={src} alt={alt} width={1200} class:list={['w-full !my-0 rounded-3xl shadow-lg', widthClass]} />
      </div>
    ) : (
      <Image src={src} alt={alt} width={1200} class:list={['w-full rounded-xl', widthClass]} />
    )
  }
  {caption && <figcaption class="media-caption mt-3 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
