---
// Gráfico de puntos (una fila por escenario) con umbrales verticales. Cada
// estado del marcador se distingue por FORMA y relleno, no sólo por color:
//   both  → círculo sólido       (ejecuta con ambos perfiles)
//   some  → círculo con aro      (ejecuta sólo con el perfil más permisivo)
//   below → aro punteado vacío   (la acción es automatizable, pero no llega al umbral)
//   never → cuadrado oscuro      (nunca se automatiza: decide la persona)
interface Item {
  label: string;
  sub?: string;
  value: number;
  kind: 'both' | 'some' | 'below' | 'never';
}

interface Threshold {
  value: number;
  label: string;
  // `top` pinta la etiqueta arriba de las filas, `bottom` abajo, para que dos
  // umbrales cercanos no se pisen.
  position: 'top' | 'bottom';
}

interface Legend {
  both: string;
  some: string;
  below: string;
  never: string;
}

interface Props {
  items: Item[];
  thresholds: Threshold[];
  legend: Legend;
  title: string;
  caption?: string;
  valueLabel: string;
  min?: number;
  max?: number;
}

const { items, thresholds, legend, title, caption, valueLabel, min = 65, max = 100 } = Astro.props;
const pct = (v: number) => ((v - min) / (max - min)) * 100;
const sorted = [...items].sort((a, b) => b.value - a.value);
---

<figure class="not-prose media-bleed my-10" data-reveal>
  <p class="font-display text-lg font-bold tracking-tightest text-ink">{title}</p>

  <ul class="mt-3 grid grid-cols-1 gap-x-6 gap-y-2 text-sm text-ink-muted sm:grid-cols-2">
    <li class="flex items-center gap-2">
      <span class="inline-block h-3.5 w-3.5 rounded-full bg-accent" aria-hidden="true"></span>{legend.both}
    </li>
    <li class="flex items-center gap-2">
      <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-accent bg-accent-muted" aria-hidden="true"></span
      >{legend.some}
    </li>
    <li class="flex items-center gap-2">
      <span class="inline-block h-3.5 w-3.5 rounded-full border-2 border-dashed border-ink-muted bg-paper" aria-hidden="true"
      ></span>{legend.below}
    </li>
    <li class="flex items-center gap-2">
      <span class="inline-block h-3 w-3 bg-ink" aria-hidden="true"></span>{legend.never}
    </li>
  </ul>

  <div class="mt-6" aria-hidden="true">
    <div class="sm:grid sm:grid-cols-[12.5rem_minmax(0,1fr)]">
      <div class="hidden sm:block"></div>
      <div class="relative h-9">
        {
          thresholds
            .filter((t) => t.position === 'top')
            .map((t) => (
              <span
                class="absolute bottom-1 -translate-x-full pr-2 text-right text-xs leading-tight font-semibold text-ink"
                style={`left:${pct(t.value)}%`}
              >
                {t.label}
              </span>
            ))
        }
      </div>
    </div>

    {
      sorted.map((item) => (
        <div class="border-t border-border/40 sm:grid sm:grid-cols-[12.5rem_minmax(0,1fr)] sm:items-center">
          <p class="pt-2 pr-3 text-sm leading-tight text-ink sm:py-2">
            <span class="font-medium">{item.label}</span>
            {item.sub && <span class="block text-xs text-ink-muted">{item.sub}</span>}
          </p>
          <div class="relative h-10">
            {thresholds.map((t) => (
              <span
                class="absolute inset-y-0 border-l border-dashed border-ink-muted/70"
                style={`left:${pct(t.value)}%`}
              />
            ))}
            <span
              class="absolute top-1/2 flex -translate-x-1/2 -translate-y-1/2 items-center"
              style={`left:${pct(item.value)}%`}
            >
              {item.kind === 'both' && <span class="h-4 w-4 rounded-full bg-accent" />}
              {item.kind === 'some' && <span class="h-4 w-4 rounded-full border-2 border-accent bg-accent-muted" />}
              {item.kind === 'below' && (
                <span class="h-4 w-4 rounded-full border-2 border-dashed border-ink-muted bg-paper" />
              )}
              {item.kind === 'never' && <span class="h-3.5 w-3.5 bg-ink" />}
            </span>
            <span
              class="absolute top-1/2 -translate-y-1/2 bg-paper px-1 text-xs font-semibold text-ink tabular-nums"
              style={
                item.value >= 96
                  ? `right:calc(${100 - pct(item.value)}% + 12px)`
                  : `left:calc(${pct(item.value)}% + 12px)`
              }
            >
              {item.value} %
            </span>
          </div>
        </div>
      ))
    }

    <div class="border-t border-border/40 sm:grid sm:grid-cols-[12.5rem_minmax(0,1fr)]">
      <div class="hidden sm:block"></div>
      <div class="relative h-9">
        {
          thresholds
            .filter((t) => t.position === 'bottom')
            .map((t) => (
              <span
                class="absolute top-1 -translate-x-full pr-2 text-right text-xs leading-tight font-semibold text-ink"
                style={`left:${pct(t.value)}%`}
              >
                {t.label}
              </span>
            ))
        }
        <span class="absolute top-1 left-0 text-xs text-ink-muted">{min} %</span>
      </div>
    </div>
  </div>

  <div
    class="not-prose"
    style="position:absolute;top:0;left:0;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0"
  >
    <table
      class="sr-only"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0"
    >
      <caption>{title}</caption>
      <thead>
        <tr>
          <th scope="col"></th>
          <th scope="col">{valueLabel}</th>
          <th scope="col"></th>
        </tr>
      </thead>
      <tbody>
        {
          sorted.map((item) => (
            <tr>
              <th scope="row">
                {item.label}
                {item.sub ? ` · ${item.sub}` : ''}
              </th>
              <td>{item.value} %</td>
              <td>{legend[item.kind]}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {caption && <figcaption class="mt-5 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
