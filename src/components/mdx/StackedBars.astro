---
interface Series {
  label: string;
  tone: 'open' | 'waiting' | 'done' | 'returned';
}

interface Row {
  label: string;
  values: number[];
}

interface Props {
  rows: Row[];
  series: Series[];
  title: string;
  caption?: string;
  totalLabel: string;
}

const { rows, series, title, caption, totalLabel } = Astro.props;

const max = Math.max(...rows.map((row) => row.values.reduce((a, b) => a + b, 0)));

// Cada serie se distingue por relleno + patrón (no sólo por color) y siempre
// muestra su número dentro del segmento. Todo texto queda en tinta/papel con
// contraste >= 4.5:1 sobre su fondo.
const toneClass = {
  open: 'bg-accent-muted text-ink ring-1 ring-inset ring-accent/50',
  waiting: 'bg-ink-muted text-paper',
  done: 'bg-ink text-paper',
  returned: 'bg-paper text-ink ring-1 ring-inset ring-ink',
};
const hatch =
  'background-image:repeating-linear-gradient(135deg,transparent 0 5px,rgb(26 23 20 / .28) 5px 6px)';
---

<figure class="not-prose media-bleed my-10" data-reveal>
  <p class="font-display text-lg font-bold tracking-tightest text-ink">{title}</p>

  <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-ink-muted">
    {
      series.map((item) => (
        <li class="flex items-center gap-2">
          <span
            class:list={['inline-block h-3.5 w-3.5 rounded-sm', toneClass[item.tone]]}
            style={item.tone === 'returned' ? hatch : undefined}
            aria-hidden="true"
          />
          {item.label}
        </li>
      ))
    }
  </ul>

  <div class="mt-5 space-y-3">
    {
      rows.map((row) => {
        const total = row.values.reduce((a, b) => a + b, 0);
        return (
          <div class="grid grid-cols-[minmax(0,1fr)_2rem] items-center gap-x-3 gap-y-1 sm:grid-cols-[11rem_minmax(0,1fr)_2rem]">
            <p class="col-span-2 text-sm font-medium text-ink sm:col-span-1">{row.label}</p>
            <div class="flex h-8 gap-0.5" style={`width:${(total / max) * 100}%`}>
              {row.values.map(
                (value, index) =>
                  value > 0 && (
                    <div
                      class:list={[
                        'flex items-center justify-center text-xs font-semibold first:rounded-l-md last:rounded-r-md',
                        toneClass[series[index].tone],
                      ]}
                      style={`flex:${value} 1 0;${series[index].tone === 'returned' ? hatch : ''}`}
                      title={`${series[index].label}: ${value}`}
                    >
                      <span class:list={[series[index].tone === 'returned' && 'rounded bg-paper px-1']}>{value}</span>
                    </div>
                  ),
              )}
            </div>
            <p class="text-right text-sm tabular-nums text-ink-muted" aria-hidden="true">
              {total}
            </p>
          </div>
        );
      })
    }
  </div>

  <div
    class="not-prose"
    style="position:absolute;top:0;left:0;width:1px;height:1px;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0"
  >
    <table
      class="sr-only"
      style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);clip-path:inset(50%);white-space:nowrap;border:0"
    >
      <caption>{title}</caption>
      <thead>
        <tr>
          <th scope="col"></th>
          {series.map((item) => <th scope="col">{item.label}</th>)}
          <th scope="col">{totalLabel}</th>
        </tr>
      </thead>
      <tbody>
        {
          rows.map((row) => (
            <tr>
              <th scope="row">{row.label}</th>
              {row.values.map((value) => <td>{value}</td>)}
              <td>{row.values.reduce((a, b) => a + b, 0)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  {caption && <figcaption class="mt-5 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
