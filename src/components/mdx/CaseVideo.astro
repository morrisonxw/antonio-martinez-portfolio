---
interface Props {
  src: string;
  poster: string;
  label: string;
  caption: string;
}

const { src, poster, label, caption } = Astro.props;
---

<figure class="media-bleed my-10" data-case-video>
  <div class="relative overflow-hidden rounded-xl bg-ink/5">
    <video
      src={src}
      poster={poster}
      controls
      preload="metadata"
      playsinline
      data-inline-playback
      class="block w-full"
      aria-label={label}
    >
      <p>
        Tu navegador no puede reproducir este video.
        <a href={src}>Abrir el archivo de video</a>
      </p>
    </video>

    <button
      type="button"
      data-video-play
      class="absolute inset-0 flex cursor-pointer items-center justify-center bg-ink/10 transition-colors hover:bg-ink/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-[-4px] focus-visible:outline-white"
      aria-label={label}
    >
      <span class="flex h-16 w-16 items-center justify-center rounded-full border border-white/70 bg-ink/80 text-white shadow-lg backdrop-blur-sm">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="ml-1 h-7 w-7 fill-current">
          <path d="M8 5.5v13l10-6.5L8 5.5Z" />
        </svg>
      </span>
    </button>
  </div>
  <figcaption class="media-caption mt-3 text-sm text-ink-muted">{caption}</figcaption>
</figure>

<script>
  function setupCaseVideos() {
    document.querySelectorAll<HTMLElement>('[data-case-video]').forEach((player) => {
      if (player.dataset.ready === 'true') return;

      const video = player.querySelector<HTMLVideoElement>('video');
      const playButton = player.querySelector<HTMLButtonElement>('[data-video-play]');
      if (!video || !playButton) return;

      player.dataset.ready = 'true';
      const showButton = () => playButton.classList.remove('hidden');
      const hideButton = () => playButton.classList.add('hidden');

      playButton.addEventListener('click', () => video.play().catch(showButton));
      video.addEventListener('play', hideButton);
      video.addEventListener('ended', showButton);
      video.addEventListener('error', showButton);
    });
  }

  document.addEventListener('astro:page-load', setupCaseVideos);
</script>
