---
interface Props {
  src: string;
  poster: string;
  label: string;
  caption: string;
}

const { src, poster, label, caption } = Astro.props;
---

<figure class="media-bleed my-10" data-case-video>
  <div class="overflow-hidden rounded-xl bg-ink/5">
    <video
      src={src}
      poster={poster}
      autoplay
      muted
      loop
      preload="auto"
      playsinline
      data-inline-playback
      class="block w-full"
      aria-label={label}
    >
      <p>
        Tu navegador no puede reproducir este video.
        <a href={src}>Abrir el archivo de video</a>
      </p>
    </video>
  </div>
  <figcaption class="media-caption mt-3 text-sm text-ink-muted">{caption}</figcaption>
</figure>
