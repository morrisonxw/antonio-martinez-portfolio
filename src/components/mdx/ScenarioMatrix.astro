---
interface Quadrant {
  title: string;
  description: string;
  x: 'left' | 'right';
  y: 'top' | 'bottom';
}

interface Props {
  quadrants: Quadrant[];
  axisX: string;
  axisXLow: string;
  axisXHigh: string;
  axisY: string;
  axisYLow: string;
  axisYHigh: string;
  caption?: string;
}

const { quadrants, axisX, axisXLow, axisXHigh, axisY, axisYLow, axisYHigh, caption } = Astro.props;
const wrap = (value: string, width = 43) => {
  const words = value.split(' ');
  const lines: string[] = [];
  let line = '';
  for (const word of words) {
    if (line && `${line} ${word}`.length > width) {
      lines.push(line);
      line = word;
    } else line = line ? `${line} ${word}` : word;
  }
  if (line) lines.push(line);
  return lines.slice(0, 4);
};
const cells = {
  'left-top': { x: 154, y: 62, fill: 'fill-paper-muted' },
  'right-top': { x: 472, y: 62, fill: 'fill-accent-muted/50' },
  'left-bottom': { x: 154, y: 245, fill: 'fill-paper' },
  'right-bottom': { x: 472, y: 245, fill: 'fill-accent-muted/30' },
};
---

<figure class="not-prose media-bleed my-10" data-reveal>
  <div class="overflow-x-auto">
    <svg viewBox="0 0 850 500" class="block h-auto min-w-[740px] w-full" role="img" aria-label={`${axisY}: ${axisYHigh} to ${axisYLow}; ${axisX}: ${axisXLow} to ${axisXHigh}. ${quadrants.map((q) => `${q.title}: ${q.description}`).join(' ')}`}>
      <text x="154" y="32" class="fill-ink text-[12px] font-semibold tracking-[0.1em]">ESCENARIOS PLAUSIBLES</text>
      {quadrants.map((q) => {
        const box = cells[`${q.x}-${q.y}` as keyof typeof cells];
        const lines = wrap(q.description);
        const titleLines = wrap(q.title, 36);
        return <g>
          <rect x={box.x} y={box.y} width="318" height="183" class={`${box.fill} stroke-border`} stroke-width="1" />
          <text x={box.x + 20} y={box.y + 34} class="fill-accent-strong text-[10px] font-semibold tracking-[0.12em]">{q.y === 'top' ? 'COMPETENCIA RÁPIDA' : 'COMPETENCIA LENTA'} · {q.x === 'left' ? 'DATOS RESTRINGIDOS' : 'DATOS ABIERTOS'}</text>
          <text x={box.x + 20} y={box.y + 72} class="fill-ink text-[16px] font-bold">
            {titleLines.map((line, index) => <tspan x={box.x + 20} dy={index === 0 ? 0 : 20}>{line}</tspan>)}
          </text>
          <text x={box.x + 20} y={box.y + 126} class="fill-ink-muted text-[12px]">
            {lines.map((line, index) => <tspan x={box.x + 20} dy={index === 0 ? 0 : 17}>{line}</tspan>)}
          </text>
        </g>;
      })}
      <line x1="154" y1="245" x2="790" y2="245" class="stroke-ink" stroke-width="1.5" />
      <line x1="472" y1="62" x2="472" y2="428" class="stroke-ink" stroke-width="1.5" />
      <line x1="154" y1="447" x2="790" y2="447" class="stroke-ink-muted" stroke-width="1.3" marker-end="url(#matrix-arrow-x)" />
      <defs><marker id="matrix-arrow-x" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M1 1 L7 4 L1 7" class="fill-none stroke-ink-muted" stroke-width="1.4" /></marker>
      <marker id="matrix-arrow-y" markerWidth="8" markerHeight="8" refX="6" refY="4" orient="auto"><path d="M1 1 L7 4 L1 7" class="fill-none stroke-ink-muted" stroke-width="1.4" /></marker></defs>
      <line x1="132" y1="428" x2="132" y2="62" class="stroke-ink-muted" stroke-width="1.3" marker-end="url(#matrix-arrow-y)" />
      <text x="154" y="470" class="fill-ink-muted text-[10px]">{axisXLow}</text>
      <text x="682" y="470" class="fill-ink-muted text-[10px]">{axisXHigh}</text>
      <text x="472" y="493" text-anchor="middle" class="fill-ink text-[11px] font-semibold">{axisX}</text>
      <text x="113" y="87" text-anchor="end" class="fill-ink-muted text-[10px]">{axisYHigh}</text>
      <text x="113" y="421" text-anchor="end" class="fill-ink-muted text-[10px]">{axisYLow}</text>
      <text x="28" y="250" text-anchor="middle" transform="rotate(-90 28 250)" class="fill-ink text-[11px] font-semibold">{axisY}</text>
    </svg>
  </div>
  <p class="mt-3 text-xs text-ink-muted">Matriz 2 × 2 de escenarios, no una matriz de probabilidad ni una valoración de impacto.</p>
  {caption && <figcaption class="mt-3 text-sm text-ink-muted">{caption}</figcaption>}
</figure>
