---
import { getCollection, render } from 'astro:content';
import CaseStudyLayout from '../../layouts/CaseStudyLayout.astro';
import { sortByPortfolioOrder } from '../../lib/project-order';

export async function getStaticPaths() {
  const projects = sortByPortfolioOrder(await getCollection('projects', ({ data }) => !data.draft));

  return projects.flatMap((project, index) =>
    project.data.externalUrl
      ? []
      : [{
          params: { slug: project.id },
          props: {
            project,
            prev: projects[index - 1],
            next: projects[index + 1],
          },
        }],
  );
}

const { project, prev, next } = Astro.props;
const { Content, remarkPluginFrontmatter } = await render(project);
---

<CaseStudyLayout project={project} prev={prev} next={next} readingTime={remarkPluginFrontmatter.readingTime}>
  <Content />
</CaseStudyLayout>
