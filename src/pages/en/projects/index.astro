---
import { getCollection } from 'astro:content';
import PageLayout from '../../../layouts/PageLayout.astro';
import Container from '../../../components/ui/Container.astro';
import SectionHeading from '../../../components/ui/SectionHeading.astro';
import ProjectGrid from '../../../components/project/ProjectGrid.astro';
import { t } from '../../../i18n/ui';
import { homeHref } from '../../../i18n/paths';

// Sección temporalmente fuera del sitio público mientras se rediseña.
// Sigue completa en `astro dev`; en cualquier build (prod o preview local)
// redirige al inicio. Quitar este bloque para volver a publicarla.
if (!import.meta.env.DEV) {
  return Astro.redirect(homeHref('en'));
}

const allProjects = (await getCollection('projectsEn', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.year - a.data.year || a.data.order - b.data.order,
);
---

<PageLayout title={t('en', 'projects.title')} description={t('en', 'projects.description')}>
  <Container class="pt-16 pb-24 sm:pt-20">
    <SectionHeading as="h1" eyebrow={t('en', 'projects.eyebrow')} class="mb-12" data-reveal>
      {t('en', 'projects.heading')}
    </SectionHeading>
    <ProjectGrid projects={allProjects} />
  </Container>
</PageLayout>
