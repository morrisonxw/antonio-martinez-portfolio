---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import HomeProjectGrid from '../../components/home/HomeProjectGrid.astro';
import HomeProjectFilters from '../../components/home/HomeProjectFilters.astro';
import PinnedHero from '../../components/home/PinnedHero.astro';
import { site } from '../../content-data/site.en';
import { experience } from '../../content-data/experience.en';
import { projectOrderIndex } from '../../lib/project-order';

const allProjects = await getCollection('projectsEn', ({ data }) => !data.draft);
const projectsById = new Map(allProjects.map((project) => [project.id, project]));

const timeline = experience
  .map((item) => ({
    ...item,
    projects: item.projectSlugs
      .map((slug) => projectsById.get(slug))
      .filter((project) => project !== undefined),
  }))
  .filter((item) => item.projects.length > 0);

const slugsInTimeline = new Set(experience.flatMap((item) => item.projectSlugs));
const featured = allProjects
  .filter((p) => p.data.featured && !slugsInTimeline.has(p.id))
  .sort((a, b) => a.data.order - b.data.order);
const projectsToShow = featured.length > 0 ? featured : allProjects.filter((p) => !slugsInTimeline.has(p.id)).slice(0, 4);
const independentCompany = (projectId: string) => (projectId === 'dropi-novedades' ? 'Dropi' : 'Zubank');
const mercadoLibre = timeline.find((item) => item.company === 'Mercado Libre');
const remainingExperience = timeline.filter((item) => item !== mercadoLibre);
const homeItems = [
  ...(mercadoLibre?.projects.map((project) => ({ project, company: mercadoLibre.company })) ?? []),
  ...projectsToShow.map((project) => ({ project, company: independentCompany(project.id) })),
  ...remainingExperience.flatMap((item) => item.projects.map((project) => ({ project, company: item.company }))),
].sort((a, b) => projectOrderIndex(a.project.id) - projectOrderIndex(b.project.id));
const homeProjects = homeItems.map(({ project }) => project);
---

<PageLayout title={site.name} description={site.description}>
  <PinnedHero />

  <Container class="pb-8 pt-8 sm:pb-12 sm:pt-10" data-reveal>
    <HomeProjectFilters projects={homeProjects} />
  </Container>

  <HomeProjectGrid items={homeItems} label="Projects" />
</PageLayout>
