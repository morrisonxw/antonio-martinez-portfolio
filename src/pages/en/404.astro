---
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import { t } from '../../i18n/ui';
import { homeHref } from '../../i18n/paths';
---

<PageLayout title={t('en', '404.title')} description={t('en', '404.description')}>
  <Container class="flex min-h-[60vh] flex-col items-start justify-center py-24">
    <p class="text-sm font-medium text-accent">404</p>
    <h1 class="mt-3 font-display text-4xl font-bold text-ink sm:text-5xl">
      {t('en', '404.heading')}
    </h1>
    <p class="mt-4 text-ink-muted">{t('en', '404.body')}</p>
    <div class="mt-8">
      <Button href={homeHref('en')}>{t('en', '404.cta')}</Button>
    </div>
  </Container>
</PageLayout>
