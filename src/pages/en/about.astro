---
import { Image } from 'astro:assets';
import PageLayout from '../../layouts/PageLayout.astro';
import Container from '../../components/ui/Container.astro';
import Button from '../../components/ui/Button.astro';
import Tag from '../../components/ui/Tag.astro';
import { site } from '../../content-data/site.en';
import { experience } from '../../content-data/experience.en';
import { about } from '../../content-data/about.en';
import { t } from '../../i18n/ui';
import { contactHref, projectsHref } from '../../i18n/paths';
import profilePhoto from '../../assets/profile/antonio.jpg';
---

<PageLayout title={t('en', 'about.title')} description={`${t('en', 'about.description')} ${site.name}, ${site.role}.`}>
  <Container class="pt-16 pb-24 sm:pt-20">
    <div class="grid max-w-[var(--prose-width)] grid-cols-1 gap-6 sm:grid-cols-[auto_1fr] sm:items-center sm:gap-8" data-reveal>
      <Image
        src={profilePhoto}
        alt={site.name}
        width={160}
        height={160}
        class="h-32 w-32 rounded-full object-cover sm:h-40 sm:w-40"
      />
      <div>
        <p class="text-sm font-medium text-accent">{t('en', 'about.eyebrow')}</p>
        <h1 class="mt-3 font-display text-4xl font-bold tracking-tightest text-ink sm:text-6xl">
          {t('en', 'about.greeting')} {site.name}.
        </h1>
      </div>
    </div>

    <div class="max-w-[var(--prose-width)]">
      <div class="mt-8 space-y-8">
        {
          about.sections.map((section) => (
            <div>
              <h2 class="font-display text-lg font-bold tracking-tightest text-ink">{section.heading}</h2>
              <p class="mt-2 text-ink-muted">{section.body}</p>
            </div>
          ))
        }
      </div>

      <div class="mt-10">
        <h2 class="font-display text-lg font-bold tracking-tightest text-ink">{t('en', 'about.skillsHeading')}</h2>
        <div class="mt-3 flex flex-wrap gap-2">
          {about.skills.map((skill) => <Tag>{skill}</Tag>)}
        </div>
      </div>

      <div class="mt-10 flex flex-wrap gap-4">
        <Button href={contactHref('en')}>{t('en', 'about.contactButton')}</Button>
        <Button href={projectsHref('en')} variant="secondary">{t('en', 'about.projectsButton')}</Button>
      </div>
    </div>

    <div class="mt-20 max-w-[var(--prose-width)]" data-reveal>
      <h2 class="font-display text-2xl font-bold tracking-tightest text-ink">{t('en', 'about.trajectoryHeading')}</h2>
      <p class="mt-2 text-ink-muted">{about.experienceIntro}</p>
      <ul class="mt-6 divide-y divide-border border-y border-border">
        {
          experience.map((item) => (
            <li class="flex flex-col gap-1 py-5 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="font-medium text-ink">{item.role}</p>
                <p class="text-sm text-ink-muted">{item.company}</p>
              </div>
              <span class="inline-flex w-fit items-center rounded-full border border-border px-3 py-1 text-xs font-medium text-ink-muted">
                {item.period}
              </span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="mt-20 max-w-[var(--prose-width)] border-l-2 border-accent pl-6" data-reveal>
      <p class="font-display text-xl font-medium tracking-tightest text-ink sm:text-2xl">
        "{about.philosophy}"
      </p>
    </div>
  </Container>
</PageLayout>
